diff --git a/src/meson.build b/src/meson.build
index 691f9b9..19f8560 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -692,7 +692,19 @@ if not get_option('subset').disabled()
       output: 'harfbuzz-subset.def')
   defs_list += [harfbuzz_subset_def]
 
-  libharfbuzz_subset = library('harfbuzz-subset', hb_subset_sources,
+  # A static libharfbuzz-subset takes the sources it shares with libharfbuzz from libharfbuzz.a, which it always needs:
+  # a copy of their symbols in each archive clashes where an app links both.
+  hb_subset_library_sources = hb_subset_sources
+  if get_option('default_library') == 'static'
+    hb_subset_library_sources = []
+    foreach source : hb_subset_sources
+      if fs.name(source) not in ['VARC.cc', 'hb-number.cc', 'hb-ot-cff1-table.cc', 'hb-ot-cff2-table.cc', 'hb-static.cc']
+        hb_subset_library_sources += source
+      endif
+    endforeach
+  endif
+
+  libharfbuzz_subset = library('harfbuzz-subset', hb_subset_library_sources,
     include_directories: incconfig,
     dependencies: common_harfbuzz_deps,
     link_with: [libharfbuzz],
@@ -759,7 +771,18 @@ if not get_option('raster').disabled()
     raster_deps += [png_dep]
   endif
 
-  libharfbuzz_raster = library('harfbuzz-raster', hb_raster_sources,
+  # A static libharfbuzz-raster takes hb-static.cc from libharfbuzz.a, which it always needs, as libharfbuzz-subset does.
+  hb_raster_library_sources = hb_raster_sources
+  if get_option('default_library') == 'static'
+    hb_raster_library_sources = []
+    foreach source : hb_raster_sources
+      if fs.name(source) != 'hb-static.cc'
+        hb_raster_library_sources += source
+      endif
+    endforeach
+  endif
+
+  libharfbuzz_raster = library('harfbuzz-raster', hb_raster_library_sources,
     include_directories: incconfig,
     dependencies: raster_deps,
     link_with: [libharfbuzz],
