+/* Runs an external filter with its standard input on in and its standard output on out. */
+static bool run_external (struct filter *f, FILE *in, FILE *out)
+{
+	int     saved_in, saved_out;
+	intptr_t status;
+	char   *quoted;
+	const char **argv;
+	int     i;
+
+	/* _spawnvp() joins the arguments with spaces: the program's name quoted, as it may have spaces */
+	quoted = malloc (strlen (f->argv[0]) + 3);
+	argv = malloc (sizeof (char *) * (size_t) (f->argc + 1));
+	if (!quoted || !argv)
+		lerr_fatal (_("memory allocation failed in %s()"), "run_external");
+	sprintf (quoted, "\"%s\"", f->argv[0]);
+	argv[0] = quoted;
+	for (i = 1; i <= f->argc; ++i)
+		argv[i] = f->argv[i];
+
+	fflush (out);
+	fflush (stdout);
+	fflush (stderr);
+	if ((saved_in = _dup (0)) == -1 || (saved_out = _dup (1)) == -1)
+		lerr_fatal (_("%s failed"), "dup");
+	if (_dup2 (_fileno (in), 0) == -1 || _dup2 (_fileno (out), 1) == -1)
+		lerr_fatal (_("%s failed"), "dup2");
+	status = _spawnvp (_P_WAIT, f->argv[0], argv);
+	_dup2 (saved_in, 0);
+	_dup2 (saved_out, 1);
+	_close (saved_in);
+	_close (saved_out);
+	free (quoted);
+	free ((void *) argv);
+
+	if (status == -1)
+		lerr_fatal (_("exec of %s failed"), f->argv[0]);
+	return status == 0;
+}
+
+/* Runs chain from in, rewound here, into out. */
+static bool run_chain (struct filter *chain, FILE *in, FILE *out)
+{
+	FILE   *mid;
+	bool    ok;
+	char    buf[4096];
+	size_t  n;
+
+	rewind (in);
+	if (!chain) {
+		while ((n = fread (buf, 1, sizeof buf, in)) > 0)
+			fwrite (buf, 1, n, out);
+		return true;
+	}
+
+	if (chain->filter_func == filter_tee_header) {
+		FILE   *to_c = temporary_file ();
+		FILE   *to_h = chain->extra != NULL ? temporary_file () : NULL;
+		FILE   *header;
+
+		tee_streams (in, to_c, to_h);
+		ok = run_chain (chain->next, to_c, out);
+		fclose (to_c);
+		if (to_h != NULL) {
+			if ((header = fopen ((char *) chain->extra, "wb")) == NULL)
+				lerr_fatal (_("%s failed"), "fopen(headerfilename)");
+			ok = run_chain (chain->next, to_h, header) && ok;
+			if (ferror (header))
+				lerr (_("error writing output file %s"), (char *) chain->extra);
+			else if (fclose (header))
+				lerr (_("error closing output file %s"), (char *) chain->extra);
+			fclose (to_h);
+		}
+		return ok;
+	}
+
+	mid = chain->next != NULL ? temporary_file () : out;
+	if (chain->filter_func == filter_fix_linedirs) {
+		fix_linedirs_streams (in, mid);
+		ok = true;
+	}
+	else if (chain->filter_func == NULL) {
+		ok = run_external (chain, in, mid);
+		/* m4 writes its output as text */
+		if (mid != out)
+			_setmode (_fileno (mid), _O_TEXT);
+	}
+	else
+		lerr_fatal (_("%s failed"), "filter_func");
+
+	if (mid != out) {
+		ok = run_chain (chain->next, mid, out) && ok;
+		fclose (mid);
+	}
+	return ok;
+}
+
+bool filter_run_deferred (bool run)
+{
+	struct filter *chain = deferred_chain;
+	FILE   *out;
+	bool    ok = true;
+
+	/* once, also when a filter fails fatally and flex ends again */
+	if (chain == NULL)
+		return true;
+	deferred_chain = NULL;
+
+	if (run) {
+		if (deferred_out != -1)
+			out = _fdopen (deferred_out, "wb");
+		else
+			/* after what flex wrote to it before the chain began */
+			out = fopen (env.outfilename, "ab");
+		if (out == NULL)
+			lerr_fatal (_("could not create %s"),
+				env.outfilename != NULL ? env.outfilename : "<stdout>");
+		deferred_out = -1;
+		ok = run_chain (chain, deferred_in, out);
+		if (ferror (out))
+			lerr (_("error writing output file %s"),
+				env.outfilename != NULL ? env.outfilename : "<stdout>");
+		else if (fclose (out))
+			lerr (_("error closing output file %s"),
+				env.outfilename != NULL ? env.outfilename : "<stdout>");
+	}
+	if (deferred_out != -1)
+		_close (deferred_out);
+	fclose (deferred_in);
+	deferred_in = NULL;
+	return ok;
 }
+#endif /* _WIN32 */
 
